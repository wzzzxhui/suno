# HTTP
SUNO_HTTP_ADDR=:8080
SUNO_ALLOWED_ORIGINS=*

# MySQL
SUNO_MYSQL_DSN=root:root@tcp(127.0.0.1:3306)/suno_open?parseTime=true&charset=utf8mb4&loc=Local

# Provider: mock（默认，本地模拟）| suno（转发真实上游）
SUNO_PROVIDER=mock
SUNO_UPSTREAM_BASE=https://open.suno.cn
SUNO_UPSTREAM_KEY=
SUNO_UPSTREAM_TIMEOUT=60s

# mock provider：多久之后产出结果、资源地址前缀
SUNO_MOCK_DELAY=12s
SUNO_MOCK_CDN_BASE=https://cdn.example.com/suno-mock

# 任务轮询
SUNO_POLL_INTERVAL=5s
SUNO_POLL_WORKERS=4
SUNO_TASK_TIMEOUT=15m

# 限流与赠送积分
SUNO_RATE_LIMIT_PER_MINUTE=120
SUNO_SIGNUP_BONUS=60

# 额外模型：上游发布新版本时免改代码接入
# 格式：代号|版本|展示名|说明，多个用逗号分隔
# 例：SUNO_EXTRA_GENERATE_MODELS=chirp-newbird|V7|Suno V7|新旗舰
SUNO_EXTRA_GENERATE_MODELS=
SUNO_EXTRA_SOUND_MODELS=
SUNO_EXTRA_REMASTER_MODELS=

# 音色翻唱：腾讯多媒体实验室「唱歌克隆」
# 开通 https://buy.cloud.tencent.com/imusic 后调用 /register 注册，按返回结果填写：
#   apiGateSecretId/apiGateSecretKey → TME_GATEWAY_*，tmpSecretId/tmpSecretKey → TME_SECRET_*，tmpContentId → TME_CONTENT_ID
# TME_SOURCE 为签名用的 Source 头（文档示例为 uin_userName 形式）
# 结果写入注册时绑定的 COS 存储桶，TME_OUTPUT_BASE 填该仓库根目录的可访问地址（公读桶域名或 CDN）
# 未配置时音色训练与翻唱使用本地模拟
TME_BASE=https://api.mediax.tencent.com
TME_GATEWAY_SECRET_ID=
TME_GATEWAY_SECRET_KEY=
TME_SOURCE=
TME_SECRET_ID=
TME_SECRET_KEY=
TME_CONTENT_ID=
TME_OUTPUT_BASE=
TME_OUTPUT_DIR=/voice_cover
TME_TRAIN_TIMEOUT=3h
# 估算训练进度用的每轮耗时（秒，2026-09 实测 50 轮约 16 分钟，每轮约 20 秒）。腾讯不返回进度百分比，页面按「每轮耗时 × 轮次」估算；
# 有训练完成的记录后自动改用实际平均耗时，此值只在还没有记录时使用
TME_TRAIN_SECONDS_PER_EPOCH=20
# 注册时绑定的 COS 存储桶；填了桶名与地域可省略 TME_OUTPUT_BASE
# 桶为私有读时再填 COS 密钥，结果地址会签成临时下载链接，有效期见 TME_URL_EXPIRE
TME_COS_BUCKET=
TME_COS_REGION=
TME_COS_SECRET_ID=
TME_COS_SECRET_KEY=
TME_URL_EXPIRE=720h

# AI MV：按歌词切分镜（每段不超过 12 秒），逐段生成图片或视频，ffmpeg 拼接并配上原曲
# 成片存放在上面的 TME_COS_* 存储桶；服务器需安装 ffmpeg
# 报价 = 各镜头上游成本之和 × MV_MARKUP，按 10 积分向上取整，不低于 MV_MIN_PRICE（单位：积分，1 积分 = 0.01 元）
# 成本默认值为 2026-09 实测上游价：Seedance 每秒 480p/720p/1080p，Nano Banana 2 每张 1K/2K（1080p 用 2K 图）
MV_VIDEO_COST_480P=3.33
MV_VIDEO_COST_720P=7.74
MV_VIDEO_COST_1080P=16.65
MV_IMAGE_COST_1K=20
MV_IMAGE_COST_2K=25
MV_MARKUP=2
MV_MIN_PRICE=100
# 图片镜头使用的绘画能力（需支持 aspect_ratio），默认 Nano Banana 2
MV_IMAGE_KIND=image_nano2
# 歌词字幕字体（需含中文），留空则不提供字幕；Windows 可用 C:\Windows\Fonts\msyh.ttc
MV_FONT_FILE=
MV_MAX_DURATION=6m
MV_SEEDANCE_MODEL=doubao-seedance-1-0-pro-fast-251015
MV_CONCURRENCY=4
MV_RETRIES=3
MV_TIMEOUT=2h
# 写分镜的大模型，兼容 OpenAI Chat Completions 接口（需支持 response_format=json_object）
# 例：DeepSeek  MV_LLM_BASE_URL=https://api.deepseek.com/v1  MV_LLM_MODEL=deepseek-chat
#     通义千问  MV_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  MV_LLM_MODEL=qwen-plus
# 三项都填才启用，否则分镜按模板生成（画面会比较平淡）
MV_LLM_BASE_URL=
MV_LLM_API_KEY=
MV_LLM_MODEL=
FFMPEG_PATH=ffmpeg

# 演唱音色：Mureka（昆仑万维）支持上传 15~30 秒清唱得到演唱音色，创作时直接用这个声音演唱，不经过 Suno、也不是先生成再翻唱
# 在 https://platform.mureka.cn 注册、充值开通 API 后创建 API Key；未配置时演唱音色与创作使用本地模拟
# MUREKA_MODEL 可填 auto 或具体版本（mureka-9.5 等）；mureka-o2 不支持演唱音色，会自动改用 auto
# 价格单位为积分：SONG 为用演唱音色创作一次（产出两首），CLONE 为创建一个演唱音色
MUREKA_BASE=https://api.mureka.cn
MUREKA_API_KEY=
MUREKA_MODEL=auto
MUREKA_SONG_PRICE=36
MUREKA_CLONE_PRICE=20

# 创作证明：为作品签发 PDF 证书（作品信息 + 歌词 + 音频 SHA-256 指纹），首次签发扣 CERT_PRICE 积分，重复下载免费
# CERT_ISSUER 为签发单位，印在证书抬头与印章上
# CERT_FONT_FILE 为证书字体（需含中文，支持 .ttf/.otf/.ttc），留空则用 MV_FONT_FILE，再没有就找系统常见中文字体
# CERT_VERIFY_URL 为公开站核验页地址（如 https://open.example.com/verify），证书二维码指向它；留空则证书上不印二维码
CERT_PRICE=100
CERT_ISSUER=SUNO API 开放平台
CERT_FONT_FILE=
CERT_VERIFY_URL=

# 作品转存：生成完成后把音频与封面存到上面的 TME_COS_* 存储桶（songs/ 目录），上游地址约一天后失效
# 读取作品时换成平台副本的签名地址，此为签名有效期；启动时及之后每小时补转存历史作品
ARCHIVE_URL_EXPIRE=168h

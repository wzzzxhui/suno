[Unit]
Description=Suno Open API backend
After=network.target mysql.service
Wants=mysql.service

[Service]
User=__RUN_USER__
# 程序从当前目录读取 .env，工作目录不能改
WorkingDirectory=__INSTALL_DIR__/backend
ExecStart=__INSTALL_DIR__/backend/suno-server
Restart=always
RestartSec=3
LimitNOFILE=65535
# MV 合成的临时素材写在 /tmp，给服务单独的 /tmp
PrivateTmp=true

[Install]
WantedBy=multi-user.target
